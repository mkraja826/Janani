{
  "expo": {
    "name": "Janani",
    "slug": "janani",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "janani",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "gentle-reminders"
        }
      ],
      "./plugins/withJananiWidget"
    ],
    "android": {
      "package": "com.mkraja826.janani",
      "adaptiveIcon": {
        "backgroundColor": "#FFF7F2"
      }
    },
    "ios": {
      "bundleIdentifier": "com.mkraja826.janani",
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}

{
  "expo": {
    "name": "Janani",
    "slug": "janani",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "janani",
    "primaryColor": "#C86B7A",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/perf",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7F2",
          "image": "./assets/.generated-janani-app-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "janani-care-reminders",
          "icon": "./assets/monochrome-icon-v2.png",
          "color": "#C86B7A"
        }
      ],
      "./plugins/withJananiWidget"
    ],
    "android": {
      "package": "com.mkraja826.janani",
      "versionCode": 1,
      "allowBackup": false,
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-v2.png",
        "monochromeImage": "./assets/monochrome-icon-v2.png",
        "backgroundColor": "#FFF7F2"
      }
    },
    "ios": {
      "bundleIdentifier": "com.mkraja826.janani",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "web": {
      "favicon": "./assets/.generated-janani-app-icon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "medicalDisclaimer": "Janani provides supportive reminders and educational information. It does not diagnose, prescribe, or replace professional medical care.",
      "router": {},
      "eas": {
        "projectId": "2897dd94-47bf-4b4c-a7a9-82e40aaa65a1"
      }
    },
    "owner": "astromicirql"
  }
}

{
  "expo": {
    "name": "Janani",
    "slug": "janani",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "janani",
    "primaryColor": "#C86B7A",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "gentle-reminders"
        }
      ],
      "./plugins/withJananiWidget"
    ],
    "android": {
      "package": "com.mkraja826.janani",
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFF7F2"
      }
    },
    "ios": {
      "bundleIdentifier": "com.mkraja826.janani",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "medicalDisclaimer": "Janani provides supportive reminders and educational information. It does not diagnose, prescribe, or replace professional medical care."
    }
  }
}

# Comma-separated browser origins allowed to call the Edge Functions.
# Native Expo requests do not send an Origin header.
ALLOWED_ORIGINS=https://app.example.com

# Optional: enables Expo push access-token security when configured in Expo.
EXPO_ACCESS_TOKEN=

# Required only when Google Play purchase verification is enabled.
# Store the complete Google Play service-account JSON as a Supabase function secret.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

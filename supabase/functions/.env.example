# Comma-separated browser origins allowed to call the Edge Functions.
# Native Expo requests do not send an Origin header.
ALLOWED_ORIGINS=https://app.example.com

# Optional: enables Expo push access-token security when configured in Expo.
EXPO_ACCESS_TOKEN=

# Medical-report extraction is intentionally separate from the general Janani
# chat provider. Supported providers: gemini | openai_responses.
# The function refuses to claim a report when these are not configured.
JANANI_REPORT_EXTRACTOR_PROVIDER=gemini
JANANI_REPORT_EXTRACTOR_API_KEY=
JANANI_REPORT_EXTRACTOR_MODEL=
# Optional provider endpoint override. Leave blank to use the official API URL.
JANANI_REPORT_EXTRACTOR_API_URL=

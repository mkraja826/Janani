# Supabase public mobile configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Public support/legal configuration required before release
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://example.com/account-deletion

# Future optional features must stay disabled until their release gates pass
EXPO_PUBLIC_CARE_PLUS_VISIBLE=false
EXPO_PUBLIC_CARE_PLUS_PURCHASES_ENABLED=false
EXPO_PUBLIC_CARE_PLUS_AI_ENABLED=false
